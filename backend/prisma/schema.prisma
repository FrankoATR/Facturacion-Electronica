// Prisma schema for Postgres latest
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  ACCOUNTANT
  AUDITOR
  CUSTOMER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceType {
  ELECTRONIC // Factura electrónica normal
  TRADITIONAL // Factura tradicional
  CREDIT_FISCAL // Crédito Fiscal (tipo DTE 03) - requiere NRC del cliente
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum NotificationType {
  STOCK_LOW
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  SYSTEM_ERROR
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          Role
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoices      Invoice[]     @relation("InvoicesCreated")
  stockMoves    StockMovement[] @relation("StockMovementsCreated")
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  payments      Payment[]
  auditLogs     AuditLog[]    @relation("UserAuditLogs")
  backupRecords BackupRecord[]
  notifications Notification[]
}

model Client {
  id         String        @id @default(cuid())
  name       String        // validable: sanitized string
  taxId      String        @unique // validable: fiscal identifier
  nrc        String?       // Número de Registro de Contribuyente - requerido para crédito fiscal
  email      String?
  phone      String?
  address    String?
  status     ClientStatus  @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  invoices   Invoice[]
  users      User[]
}

model Product {
  id                String         @id @default(cuid())
  sku               String         @unique
  name              String
  category          String?
  unitPrice         Decimal        @db.Decimal(12, 2)
  taxRate           Decimal        @db.Decimal(5, 2) // percentage e.g., 13.00
  stock             Int            @default(0)
  lowStockThreshold Int            @default(5)
  status            ProductStatus  @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items             InvoiceItem[]
  stockMovements    StockMovement[]
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  reason      String?
  createdAt   DateTime          @default(now())
  createdById String?
  createdBy   User?             @relation("StockMovementsCreated", fields: [createdById], references: [id])
  invoiceId   String?
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id          String         @id @default(cuid())
  number      String         @unique
  type        InvoiceType
  status      InvoiceStatus  @default(DRAFT)
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  items       InvoiceItem[]
  stockMovements StockMovement[]
  payments    Payment[]
  dte         DTE?
  issuedAt    DateTime?
  canceledAt  DateTime?
  cancellationReason String? // Observación obligatoria al anular DTE
  paymentMethod String?      // proposed minimal field
  notes       String?
  subtotal    Decimal        @db.Decimal(12, 2) @default(0)
  taxTotal    Decimal        @db.Decimal(12, 2) @default(0)
  total       Decimal        @db.Decimal(12, 2) @default(0)
  // proposed: stub for electronic billing identifier/stamp for future integration
  electronicFiscalStamp String?
  paidTotal   Decimal        @db.Decimal(12, 2) @default(0)
  balance     Decimal        @db.Decimal(12, 2) @default(0)
  createdById String?
  createdBy   User?          @relation("InvoicesCreated", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId])
  @@index([status, type])
}

model InvoiceItem {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  description String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  discount   Decimal  @db.Decimal(12, 2) @default(0) // descuento por item
  taxRate    Decimal  @db.Decimal(5, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  taxAmount  Decimal  @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
}

// Payments registered against invoices
model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  method      String
  note        String?
  paidAt      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
}

// Electronic Tax Document lifecycle per invoice
enum DTEStatus {
  PENDING
  SENT
  ACCEPTED
  ERROR
}

model DTE {
  id          String    @id @default(cuid())
  invoiceId   String    @unique
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status      DTEStatus @default(PENDING)
  retries     Int       @default(0)
  hash        String
  lastError   String?
  sentAt      DateTime?
  ackAt       DateTime?
  xmlUrl      String?
  ackUrl      String?
}

// Append-only audit log with chained hashes
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation("UserAuditLogs", fields: [actorId], references: [id])
  action     String
  entity     String
  entityId   String
  payload    Json?
  prevHash   String?
  hash       String

  @@index([entity, entityId])
  @@index([createdAt])
}

// Backup metadata records (logical placeholders)
model BackupRecord {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  note        String?
  location    String?
}

// Notifications for users
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}


